# =============================================================================
# Pet Companion — Module 2 (Autonomous Intervention) — environment template
# Copy to .env and fill in real values. Nothing here is loaded automatically
# until you rename this file.
# =============================================================================

# ---------------------------------------------------------------------------
# LLM
# ---------------------------------------------------------------------------
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=

# ---------------------------------------------------------------------------
# MCP SELF-DISCOVERY
#
# To add a new MCP plugin you only edit this file — no code changes needed.
#
# 1. Add the server's short name (lowercase, no spaces) to MCP_SERVERS.
# 2. Define three variables for that name, replacing <NAME> with the
#    uppercased server name:
#
#      MCP_<NAME>_URL         endpoint URL of the MCP server
#      MCP_<NAME>_TRANSPORT   "streamable_http" | "sse" | "stdio"
#      MCP_<NAME>_API_KEY     optional bearer token / auth header (omit if none)
#
# At startup, agent/mcp/loader.py reads MCP_SERVERS, builds a connection
# entry for each name found, and calls MultiServerMCPClient.get_tools().
# Every tool the server exposes is discovered and registered automatically —
# nothing is hardcoded by tool name anywhere in the codebase.
#
# For "stdio" transport, instead of MCP_<NAME>_URL set:
#      MCP_<NAME>_COMMAND     executable to launch (e.g. "npx")
#      MCP_<NAME>_ARGS        space-separated args (e.g. "-y some-mcp-server")
# ---------------------------------------------------------------------------

MCP_SERVERS=maps,wikipedia

# --- Maps MCP (place search / details / contact / reviews) ---
MCP_MAPS_URL=https://your-maps-mcp-endpoint.example.com/mcp
MCP_MAPS_TRANSPORT=streamable_http
MCP_MAPS_API_KEY=

# --- Wikipedia MCP (species / pet reference info) ---
MCP_WIKIPEDIA_URL=https://your-wikipedia-mcp-endpoint.example.com/mcp
MCP_WIKIPEDIA_TRANSPORT=streamable_http
MCP_WIKIPEDIA_API_KEY=

# --- Example of adding a third plugin later (commented out) ---
# MCP_SERVERS=maps,wikipedia,petstore
# MCP_PETSTORE_URL=https://your-petstore-mcp.example.com/mcp
# MCP_PETSTORE_TRANSPORT=streamable_http
# MCP_PETSTORE_API_KEY=

# ---------------------------------------------------------------------------
# Communication tool stubs — fill in when the real integration is ready.
# Until then, agent/tools/communication/* return mocked confirmations.
# ---------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=

WHATSAPP_BUSINESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# ---------------------------------------------------------------------------
# Commerce / payment stub — Touch 'n Go eWallet placeholder.
# Until filled in, agent/tools/commerce/order_tool.py returns a mocked order.
# ---------------------------------------------------------------------------
TNG_MERCHANT_ID=
TNG_API_KEY=
TNG_API_SECRET=

# ---------------------------------------------------------------------------
# Calendar stub — used to check user availability before booking.
# ---------------------------------------------------------------------------
CALENDAR_PROVIDER=stub
GOOGLE_CALENDAR_CREDENTIALS_JSON=

# ---------------------------------------------------------------------------
# Backend / FastAPI
# ---------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
DATABASE_PATH=./data/app.db
CORS_ALLOW_ORIGINS=*

# Shared secret the ML/perception module (Module 1) must send when POSTing
# to /perception, so random clients can't inject fake pet events.
PERCEPTION_INGEST_TOKEN=
